{
  "name": "endgame-classroom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "course:kpk": "node tools/kpk-course/run.cjs",
    "course:basics": "node tools/basics-course/run.cjs",
    "course:ladder": "node tools/ladder-course/run.cjs",
    "course:pawns": "node tools/pawns-course/run.cjs",
    "course:e2e": "node tools/course-kit/e2e.cjs",
    "kit:selftest": "node tools/course-kit/selftest.cjs",
    "kit:test": "node tools/course-kit/pawn/test.cjs && node tools/course-kit/teach/test.cjs && node tools/course-kit/curricula/opposition/test.cjs",
    "kit:check": "node tools/course-kit/pawn/checker.cjs",
    "kit:regress": "node tools/course-kit/regress.cjs",
    "kit:cache": "node tools/course-kit/cache.cjs",
    "teach:report": "node tools/course-kit/teach/report.cjs",
    "curriculum:opposition": "node tools/course-kit/curricula/opposition/feasibility.cjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.6",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
